{
  "name": "@ssojet/authkit-next",
  "version": "0.1.0",
  "description": "Next.js App Router helpers and route handlers for SSOJet AuthKit",
  "keywords": ["ssojet", "authkit", "nextjs", "app-router"],
  "homepage": "https://github.com/ssojet/ssojet-authkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssojet/ssojet-authkit.git",
    "directory": "packages/authkit-next"
  },
  "license": "MIT",
  "author": "SSOJet Team",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ssojet/authkit-core": "workspace:*"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "next": "^14.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
