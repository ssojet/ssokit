# SSOKit Environment Configuration Template
# Copy this file to .env.local in your Next.js project and fill in your values

# =============================================================================
# SSOJet API Configuration (Required)
# =============================================================================
SSOJET_BASE=https://api.ssojet.com
SSOJET_CLIENT_ID=your-ssojet-client-id-here
SSOJET_CLIENT_SECRET=your-ssojet-client-secret-here
SSOJET_ISSUER=https://your-domain.auth.ssojet.com

# =============================================================================
# Client-side Configuration (Required for browser components)
# =============================================================================
NEXT_PUBLIC_SSOJET_BASE=https://api.ssojet.com
NEXT_PUBLIC_SSOJET_CLIENT_ID=your-ssojet-client-id-here

# =============================================================================
# NextAuth Configuration (Required for authentication)
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-32-characters-min

# For production, use your actual domain:
# NEXTAUTH_URL=https://your-app.com

# =============================================================================
# SSOKit Team Manager Configuration (Optional)
# =============================================================================
# Specify which roles can manage team (invite, remove, update roles)
# Comma-separated list. Defaults to "Owner" if not specified.
NEXT_PUBLIC_SSOKIT_TEAM_MANAGER_ROLES=Owner,Admin

# Server-side version (if using server-side TeamManager)
SSOKIT_TEAM_MANAGER_ROLES=Owner,Admin

# =============================================================================
# Development Configuration (Optional)
# =============================================================================
# Enable debug logging for SSOJet API calls
SSOJET_DEBUG=true

# Enable NextAuth debug logging
NEXTAUTH_DEBUG=true

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================
# Custom redirect URI (if different from NEXTAUTH_URL/api/auth/callback)
SSOJET_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Custom SSOKit theme (JSON string)
NEXT_PUBLIC_SSOKIT_THEME='{"primary":"#3b82f6","radius":"8px"}'

# =============================================================================
# Example Production Values (Replace with your actual values)
# =============================================================================
# SSOJET_BASE=https://api.ssojet.com
# SSOJET_CLIENT_ID=3bb51b8d455042ecb5bb91ce7d594bf9rVhi7tHPdZguYk8SyWqTb4ch5n7jtvrtdboo96ohjg
# SSOJET_CLIENT_SECRET=your-actual-client-secret
# SSOJET_ISSUER=https://dns-mo.auth.ssojet.com
# NEXTAUTH_URL=https://your-production-domain.com
# NEXTAUTH_SECRET=a-very-secure-32-character-secret-key