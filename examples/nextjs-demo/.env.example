# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# Required: SSOJet API Configuration
SSOJET_BASE=https://api.ssojet.com
SSOJET_API_KEY=sk_live_your_api_key_here

# Required: Webhook Security  
SSOJET_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Required: OIDC Authentication with SSOJet
SSOJET_CLIENT_ID=your-oidc-client-id
SSOJET_CLIENT_SECRET=your-oidc-client-secret
SSOJET_ISSUER=https://dns-mo.auth.ssojet.com
SSOJET_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Required: NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Optional: SCIM Integration (for automatic provisioning)
# SCIM_BASE_URL=https://your-scim-provider.com/scim/v2
# SCIM_TOKEN=your_scim_bearer_token

# Optional: Client-side Theme Configuration
# Use JSON format for custom theme or preset name
NEXT_PUBLIC_AUTHKIT_THEME=light
# NEXT_PUBLIC_AUTHKIT_THEME='{"primary":"#3b82f6","secondary":"#64748b","radius":"8px"}'

# Optional: Custom API base URL (defaults to /api/authkit)
# NEXT_PUBLIC_AUTHKIT_BASE_URL=/api/authkit

# Development: Enable debug logging
# DEBUG=ssojet:*

# Example values for testing:
# SSOJET_API_KEY=sk_test_1234567890abcdef
# SSOJET_WEBHOOK_SECRET=whsec_abcdef1234567890
# SCIM_BASE_URL=https://dev.okta.com/scim/v2
# SCIM_TOKEN=00abcdef1234567890