{
  "name": "@ssojet/ssokit-core",
  "version": "0.1.0",
  "description": "Core types, schemas, and utilities for SSOJet AuthKit",
  "keywords": ["ssojet", "authkit", "core", "types"],
  "homepage": "https://github.com/ssojet/ssojet-authkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssojet/ssojet-authkit.git",
    "directory": "packages/authkit-core"
  },
  "license": "MIT",
  "author": "SSOJet Team",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
